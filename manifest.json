{
  "manifest_version": 3,
  "name": "Auto Vertical Tabs",
  "version": "1.0.0",

  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/Deuchnord/auto-vertical-tabs",

  "default_locale": "en",

  "permissions": [
    "browserSettings",
    "storage"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "auto-verticaltabs@deuchnord.fr",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "options_ui": {
    "page": "settings/index.html"
  },

  "background": {
    "scripts": [
      "src/tabs-listener.js"
    ]
  }
}
